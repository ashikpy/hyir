# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma Postgres / PostgreSQL Database Connection URL (Pooled / Accelerate connection URL)
# Example Prisma Postgres URL: postgresql://prisma:secret@db.prisma.io:5432/jobhunt?sslmode=require
# Example Neon/Supabase URL: postgresql://user:pass@ep-cool-db.us-east-1.aws.neon.tech/jobhunt?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobhunt?schema=public"

# Direct connection URL (Used by Prisma CLI for migrations / db push when connection pooling is enabled)
# For standard direct Postgres connections, set this to the same value as DATABASE_URL
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/jobhunt?schema=public"

# Better Auth Configuration
# Secret key for encrypting sessions and tokens (generate with `openssl rand -base64 32`)
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-chars"
# Full public URL of your app in production (e.g. https://hyir.vercel.app or http://localhost:3000)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (Optional: for Google Sign-In & Google Calendar sync)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# LinkedIn OAuth (Optional: for LinkedIn Sign-In)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Gemini AI (Optional: for structured job email classification & auto-updates)
GEMINI_API_KEY=""
