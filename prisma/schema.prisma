// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Single user for personal tracking. In a multi-user app, this would link to auth.
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  applications Application[]
}

model Application {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Core Information
  slug              String            @unique
  companyName       String
  roleTitle         String
  status            ApplicationStatus @default(SAVED)
  dateApplied       DateTime?
  
  // Job Details
  jobType           JobType           @default(FULL_TIME)
  workplaceType     WorkplaceType     @default(REMOTE)
  location          String?
  salary            String?           // Free-form text for flexibility (e.g. "120k - 140k", "$100/hr")
  applicationUrl    String?
  jobDescriptionUrl String?
  
  // Contact Information
  contactName       String?
  contactRole       String?
  contactEmail      String?
  contactUrl        String?           // LinkedIn or other profile
  
  // Follow-ups & Notes
  nextFollowUpDate  DateTime?
  notes             String?           @db.Text
  resumeVersion     String?
  portfolioVersion  String?
  
  // Timestamps
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  timelineEvents    TimelineEvent[]
}

model TimelineEvent {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  date          DateTime          @default(now())
  eventType     TimelineEventType
  description   String?           @db.Text
}

enum ApplicationStatus {
  SAVED
  APPLIED
  CONTACTED
  SCREENING
  INTERVIEW
  ASSIGNMENT
  OFFER
  ACCEPTED
  REJECTED
  GHOSTED
  WITHDRAWN
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
}

enum WorkplaceType {
  REMOTE
  HYBRID
  ONSITE
}

enum TimelineEventType {
  STATUS_CHANGE
  FOLLOW_UP
  NOTE_ADDED
  CUSTOM
}
